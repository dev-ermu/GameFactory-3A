# 项目配置
# 
# .env由 config.py 自动加载，而models/，pipeline/ 都会import它，
# 所以其它地方都不需要重复读取配置。
#
# 规则
#   * 根据自己使用大模型厂商，填写API根地址（*_API_BASE）和API key。
#   * Key 只留在本文件（或进程环境变量）里，绝不写进任务文件、日志、缓存键或提交。
#
# 除云端大模型外，还支持本地大模型，但对本机及其有要求（依赖、权重、显存）。
#
# 每个云服务商需要两项：`*_API_BASE`、`*_API_KEY`。两项齐全才算配置完成；
# 缺任何一项，require_cloud() 都会把它们一次性列出来。
# 所有 URL 都由你从服务商控制台/文档取当前值填入——仓库代码里不使用硬编码地址。

# 各任务槽位使用哪个后端
# 默认值都是**本地**路线，本地路线需要下载依赖，权重，模型文件等等。
#
# 3D物体，图像/T-pose  : qwen_edit (本地)，seedream
#   音频-对白      : qwen3_tts (本地)，seed_audio
#   音频-音效      : woosh (本地)，seed_audio
#   CG 视频        : seedance，minimax-h3
#   3D 场景        : worldmirror，worldplay （均为本地；无云端服务商）
#
# 
# GAMEFACTORY3A_VIDEO_BACKEND=seedance


# 一、3D物体：trellis2 (本地)，tripo，meshy
AAAGF_3D_BACKEND=tripo

# Tripo3D
TRIPO_API_BASE=
TRIPO_API_KEY=
TRIPO_MODEL=v3.1-20260211

# Meshy
# MESHY_API_BASE=
# MESHY_API_KEY=
# MESHY_MODEL=meshy-6

# 二、图像（T-pose）与CG视频
# 一把Key同时用于 Seedream（图像）与 Seedance（视频）。
# TPOSE_GEN_BACKEND=seedream
ARK_API_BASE=
ARK_API_KEY=
SEEDREAM_MODEL=doubao-seedream-5-0-260128
SEEDANCE_MODEL=doubao-seedance-2-0-260128

# 三、音频-对白，音频-音效，用同一个key
AAAGF_DIALOGUE_BACKEND=seed_audio
AAAGF_SOUND_EFFECT_BACKEND=seed_audio
SEED_AUDIO_API_BASE=
SEED_AUDIO_API_KEY=
SEED_AUDIO_MODEL=seed-audio-1.0
SEED_AUDIO_SPEAKER_ID=

# 四、CG视频
# MiniMax Hailuo路线
# 若是选用MiniMax-H3模型，是走云端API还是本地？合法值：auto，api或local
MINIMAX_H3_RUNTIME=auto
MINIMAX_API_BASE=
MINIMAX_API_KEY=
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3

# seedance路线
# 待补充

# TODO，需要研究下
# 动作：云端绑骨 / 动画 —— Tencent Cloud TokenHub
# 首次使用前，需先在腾讯云 TokenHub 控制台里，为
# tripo-3d-* 系列开通按量后付费，否则每次调用都会失败。
# TOKENHUB_API_BASE=
# TOKENHUB_API_KEY=

# 产物与缓存
AAAGF_OUTPUT_ROOT=test_data/outputs
AAAGF_API_CACHE=test_data/outputs/_api_cache
