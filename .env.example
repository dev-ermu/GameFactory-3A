# 项目配置
# 
# 规则
#   * 根据自己使用大模型厂商，填写API根地址（*_API_BASE）和API key。
#   * Key 只留在本文件（或进程环境变量）里，绝不写进任务文件、日志、缓存键或提交。
#
# 除云端大模型外，还支持本地大模型，但对本机及其有要求。
# 判断本机能否运行本地模型：python scripts/check_local_env.py

# 各任务槽位使用哪个后端
# 全部为**云端 API** 路线；本仓库不下载任何模型权重。
#
# 3D 物体        : tripo，meshy
#   图像 / T-pose : seedream
#   音频          : seed_audio（对白与音效共用）
#   CG 视频       : seedance，minimax-h3
#   动作          : Tripo 云端骨骼绑定；重定向走本地 bpy
#


# 一、3D物体：tripo，meshy（全部为云端 API）
AAAGF_3D_BACKEND=tripo

# Tripo3D
TRIPO_API_BASE=https://openapi.tripo3d.com/v3
TRIPO_API_KEY=
TRIPO_MODEL=

# Meshy
# MESHY_API_BASE=
# MESHY_API_KEY=
# MESHY_MODEL=meshy-6

# 二、图像（T-pose）与CG视频
# 一把Key同时用于 Seedream（图像）与 Seedance（视频）。
TPOSE_GEN_BACKEND=seedream
ARK_API_BASE=https://console.volcengine.com/ark
ARK_API_KEY=
SEEDREAM_MODEL=doubao-seedream-5-0-260128
SEEDANCE_MODEL=doubao-seedance-2-0-260128

# 三、音频-对白，音频-音效，用同一个key
AAAGF_DIALOGUE_BACKEND=seed_audio
AAAGF_SOUND_EFFECT_BACKEND=seed_audio
SEED_AUDIO_API_BASE=https://ark.cn-beijing.volces.com/api/v3/responses
SEED_AUDIO_API_KEY=
SEED_AUDIO_MODEL=doubao-seed-2-0-mini-260428
# SEED_AUDIO_SPEAKER_ID=

# 四、CG视频
# GAMEFACTORY3A_VIDEO_BACKEND=seedance
# MiniMax H3 路线（市场名亦作 Hailuo 3）
# 若是选用 MiniMax H3 模型，只能走云端 API。本地运行时已移除，唯一合法值：api
MINIMAX_H3_RUNTIME=api
# MINIMAX_API_BASE=
# MINIMAX_API_KEY=
MINIMAX_CONSOLE_URL=https://platform.minimax.io/user-center/basic-information/interface-key
MINIMAX_VIDEO_MODEL=minimax-video-h3

# seedance路线
# 待补充

# TODO，需要研究下
# 五、动作：云端绑骨 / 动画 —— Tencent Cloud TokenHub
# TOKENHUB_API_BASE=
# TOKENHUB_API_KEY=
# blender安装根目录
A3GAME_BLENDER_ROOT=C:\Program Files\Blender Foundation\Blender 5.2

# 五、Godot软件路径
A3GAME_GODOT_EXECUTABLE=D:\Program Files\Godot_v4.7.1-stable_win64\Godot_v4.7.1.exe
A3GAME_GODOT_PROJECT=D:\buddy_work\ThreeKingdomsClash3A

# 产物与缓存
AAAGF_OUTPUT_ROOT=test_data/outputs
AAAGF_API_CACHE=test_data/outputs/_api_cache
